<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
        }


        .show-on-mobile-only {
            display: none;
            width: 100%;
        }


        .main-container {
            padding: 0;
            width: 100%;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }


        .w-fit {
            width: fit-content;
        }

        .h-fit {
            height: fit-content;
        }


        .container {
            margin-bottom: 10px;
            padding: 15px;
        }

        .p-x {
            padding-top: 0;
            padding-bottom: 0;
            padding-left: 50px;
            padding-right: 50px;
        }

        .no-padding {
            padding: 0;
        }



        .paragraph {
            font-size: 15px;
        }



        .header-box {
            background: #217946;
            display: flex;
            position: relative;
        }


        .header-box .image-container {
            display: flex;
        }


        .header-box .image-container img {
            margin-top: auto;
            margin-bottom: auto;
        }




        .header-box p,
        .header-box h2 {
            color: white;
        }


        .header-box .text-container {
            width: 100%;
            margin-top: 17px;
        }

        .title-1 {
            font-size: 20px;
        }

        .title-2 {
            font-size: 15px;
        }

        .margin-top {
            margin-top: 10px;
        }

        .margin-2-top {
            margin-top: 20px;
        }

        .margin-bottom {
            margin-bottom: 10px;
        }




        .margin-2-bottom {
            margin-bottom: 30px;
        }




        a {
            color: black;
        }

        .btn {
            padding: 10px;
            text-decoration: none;
            display: flex;
            border: solid 1px #F56900;
            width: fit-content;
        }

        .btn p {
            color: #F56900;
        }

        .colored-btn {
            background-color: #F56900;
        }

        .colored-btn p {
            color: white;
        }

        .main-logo {
            width: 250px;
            height: 100px;
        }



        .footer img {
            width: 120px;
            height: 60px;
        }




        @media (max-width:700px) {


            .header-box .text-container {
                margin-top: 0;
            }

            .project-table {
                padding-left: 20px;
                width: auto;
            }

            .header-box .image-container img {
                display: none;
            }

            .show-on-mobile-only {
                display: flex;
                width: 100%;
                height: fit-content;
            }


            .show-on-mobile-only .main-logo {
                height: 80px;
                width: auto;
                margin-left: auto;
                margin-right: auto;
            }


            .title-1 {
                font-size: 16px;
            }

            .title-2 {
                font-size: 12px;
            }


            .table-title {
                width: 140px;
            }



            .header-box {
                display: block;
            }


            .p-x {
                padding-top: 0;
                padding-bottom: 0;
                padding-left: 20px;
                padding-right: 20px;
            }

        }
    </style>
</head>

<body>



    <div class="main-container">

        <div class="show-on-mobile-only no-padding margin-2-bottom">
            <img src="cid:colored-logo" alt="Example Image" class="main-logo">
        </div>


        {{!-- The header of the template --}}
        <div class="header-box container margin-2-bottom">

            <div class="no-padding text-container">

                <p>Subject</p>
                <h2 class="title-1 margin-2-bottom">GreenTeam quotation</h2>

                <p class="margin-top">Project number</p>
                {{!-- This is the project name --}}
                <h2 class="title-1">{{projectNumber}}</h2>

            </div>


            <div class="image-container">
                <img src="cid:logo" alt="Example Image" class="main-logo">
            </div>

        </div>



        {{!-- The text for dear client first name --}}
        <div class="p-x  margin-2-bottom">
            <h2 class="margin-bottom title-1">Dear {{clientFirstname}},</h2>
            <p class="paragraph">
                Please find attached quotation {{quotationNumber}}. We have paid good attention to your requirements and
                are confident this is a good offer. Your project is in good hands with GreenTeam!
            </p>
            <p class="paragraph margin-top">
                Please provide your digital signature if you wish to proceed with this competitive offer:
            </p>

            <a href="/" class="colored-btn btn margin-2-top">
                <p>Accept</p>
            </a>

            <p class="paragraph margin-2-top">
                If you decide to decline the quotation, we will contact you as soon as possible on {{phonenumberClient}}
                to discuss your wishes:
            </p>


            <a href="/" class="btn margin-2-top">
                <p>Decline</p>
            </a>


            <p class="paragraph margin-2-top">
                For any questions, feel free to contact us on <strong>085 401 93 45</strong> or via
                <strong>info@greenteam.nl</strong>
            </p>

            <p class="paragraph margin-2-top">
                Our <a href="greenteam.nl/algemene-voorwaarden" class="paragraph">general terms</a> and
                conditions apply.
            </p>


            <p class="paragraph margin-2-top">
                We look forward to your response.
            </p>


        </div>




        <div class="footer p-x">

            <p class="paragraph margin-bottom">Kind regards,</p>

            <div class="margin-top">

                <p class="paragraph margin-bottom" style="font-weight: bold;">GreenTeam</p>
                <p class="paragraph margin-bottom">Floors & Stairs</p>

            </div>

        </div>


    </div>

</body>

</html>